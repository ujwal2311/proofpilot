# Copy to .env.local (git-ignored). Both host spellings are allowed by the backend's CORS config,
# but the value here must match the one you actually open in the browser.
VITE_API_URL=http://127.0.0.1:8000

# Off by default. Set to 1 only for a pilot session (HLD section 11, E5): shows the "Pilot ID"
# field and sends it as a header so the backend's opt-in event log (itself off unless
# PROOFPILOT_PILOT_LOG=1 is set server-side) can attribute lines to a participant code.
VITE_PILOT_MODE=0
