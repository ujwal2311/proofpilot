# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Node / Vite
node_modules/
dist/
.vite/

# Environment — never commit real values. `.env.*` covers .env.local, .env.production etc;
# the negation keeps the committed template visible. (`*.env` was too broad: it would also
# have swallowed a legitimately tracked file such as test.env.)
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Experiment outputs are committed deliberately (they are evidence for the report),
# so nothing under docs/ is ignored.
