      "replace": "case Not(And(items)):\n            return And(tuple(push_negation(Not(i)) for i in items))"
    },
    {
      "id": "C5",
      "desc": "De Morgan: not-Or yields Or",
      "find": "case Not(Or(items)):\n            return And(tuple(push_negation(Not(i)) for i in items))",
      "replace": "case Not(Or(items)):\n            return Or(tuple(push_negation(Not(i)) for i in items))"
    },
